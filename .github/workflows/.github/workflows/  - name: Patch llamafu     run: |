          if ! grep -q 'namespace' "$FILE"; then
            sed -i "/^android[[:space:]]*{/a\\    namespace 'com.llamafu.llamafu'" "$FILE"
          fi

          cat "$FILE"
          grep -q 'namespace' "$FILE" || {
            echo "ERROR: Namespace patch failed"
            exit 1
          }
