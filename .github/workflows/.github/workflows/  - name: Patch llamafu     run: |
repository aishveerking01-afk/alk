      - name: FORCE FIX llamafu namespace
        working-directory: rui
        shell: bash
        run: |
          FILE="$HOME/.pub-cache/hosted/pub.dev/llamafu-0.1.0/android/build.gradle"

          echo "Checking: $FILE"
          test -f "$FILE" || {
            echo "ERROR: llamafu file not found"
            exit 1
